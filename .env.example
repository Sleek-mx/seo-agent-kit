# Postgres to store daily snapshots (any Postgres: Supabase, Neon, Railway, local)
DATABASE_URL=postgres://user:pass@host:5432/db
# PGSSL=0            # uncomment for a local Postgres without SSL

# PostHog personal API key (phx_...) with "Query: Read" on your project
POSTHOG_API_KEY=phx_xxx
# Single-site mode. Project id is in PostHog > Settings > Project
POSTHOG_PROJECT_ID=123456
POSTHOG_HOST=https://us.posthog.com   # https://eu.posthog.com for EU cloud
# CHANNEL_ID=default

# Your own domain, so self-referrals group as "Internal"
SITE_DOMAIN=example.com

# ── SEO engine (.claude/skills/seo-engine) ─────────────────────────────────
# Creator OS key of the workspace that connected your WordPress blog (Settings > API keys)
CREATOROS_API_KEY=cos_live_xxx
# CREATOROS_API_URL=https://creatoros-production-5658.up.railway.app

# Model: Claude...
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5
# ...or any OpenAI-compatible API (OpenAI, OpenRouter, DeepSeek, Ollama)
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4.1-flash

# Optional: log every generation to PostHog LLM analytics (project's phc_ key)
# POSTHOG_AI_KEY=phc_xxx

# Optional: Google Search Console service account (Owner on the property)
# GSC_SA_JSON_B64=      # base64 of the JSON key
# GSC_SA_JSON_PATH=/path/to/service-account.json

# Optional: IndexNow key, also served at https://yoursite/<key>.txt
# INDEXNOW_KEY=

# SEO_DAILY_MAX=10
# SEO_PUBLISH_AS_DRAFT=1   # land posts as drafts instead of live
