# Postgres to store daily snapshots (any Postgres: Supabase, Neon, Railway, local)
DATABASE_URL=postgres://user:pass@host:5432/db
# PGSSL=0            # uncomment for a local Postgres without SSL

# PostHog personal API key (phx_...) with "Query: Read" on your project
POSTHOG_API_KEY=phx_xxx
# Single-site mode. Project id is in PostHog > Settings > Project
POSTHOG_PROJECT_ID=123456
POSTHOG_HOST=https://us.posthog.com   # https://eu.posthog.com for EU cloud
# CHANNEL_ID=default

# Your own domain, so self-referrals group as "Internal"
SITE_DOMAIN=example.com
