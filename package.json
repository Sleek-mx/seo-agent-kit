{
  "name": "seo-agent-kit",
  "version": "1.0.0",
  "description": "Self-improving SEO agent for Claude Code: writes, fact-checks and publishes WordPress posts via Creator OS, learns from PostHog signups and Google Search Console",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "snapshot": "node --env-file=.env scripts/posthog-snapshot.mjs",
    "backfill": "node --env-file=.env scripts/posthog-snapshot.mjs --days 90",
    "seo:scout": "node --env-file=.env .claude/skills/seo-engine/scripts/scout.mjs",
    "seo:publish": "node --env-file=.env .claude/skills/seo-engine/scripts/publish.mjs",
    "seo:measure": "node --env-file=.env .claude/skills/seo-engine/scripts/measure.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "pg": "^8.13.0" },
  "peerDependencies": { "react": ">=18", "recharts": ">=2" }
}
